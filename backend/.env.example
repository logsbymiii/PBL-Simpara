APP_ENV=development

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=isi_nama_database_tim
DB_USER=isi_user_postgres
DB_PASS=isi_password
DB_SSLMODE=
# Alamat front-end (untuk CORS). Sesuaikan dengan Live Server / Laragon kamu
CORS_ORIGIN=http://127.0.0.1:5500

# Cloudflare R2 untuk foto barang (opsional). Kosongkan semua -> R2 tidak aktif:
# foto unggahan disimpan di database dan foto bawaan diambil dari file statis frontend.
# Isi nilainya hanya di .env lokal / environment server, JANGAN di file ini.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=